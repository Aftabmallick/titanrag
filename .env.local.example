# ==============================================================================
# TitanRAG Local Secrets — .env.local.example
# ==============================================================================
# Copy this file to .env.local and fill in your real API keys.
# .env.local is gitignored and takes priority over .env.
#
# cp .env.local.example .env.local

# NVIDIA NIM API Key (get from build.nvidia.com)
NVIDIA_API_KEY=your-nvidia-api-key-here

# Cohere Reranker API Key (optional — for cross-encoder reranking)
COHERE_API_KEY=your-cohere-api-key-here

# Langfuse LLM Observability (optional)
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key

# Stripe Billing (optional — billing disabled if not set)
STRIPE_SECRET_KEY=sk_test_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PRO_PRICE_ID=price_your-pro-price-id
STRIPE_ENTERPRISE_PRICE_ID=price_your-enterprise-price-id

# Production secrets (required when ENVIRONMENT != development)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=your-production-secret-key
# SCIM_BEARER_TOKEN=your-scim-bearer-token
# LITELLM_MASTER_KEY=your-litellm-master-key
# POSTGRES_PASSWORD=your-strong-postgres-password
# MINIO_ROOT_PASSWORD=your-strong-minio-password
