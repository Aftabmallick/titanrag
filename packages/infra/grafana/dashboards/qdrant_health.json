      "title": "Qdrant REST Requests/s",
      "type": "graph",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "rate(rest_responses_total[1m])",
          "legendFormat": "{{endpoint}} {{status}}",
