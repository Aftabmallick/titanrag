# ==============================================================================
# TitanRAG Container & Development Environment Defaults
# ==============================================================================

# Core System
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
APP_NAME=TitanRAG
API_V1_STR=/api/v1
PROJECT_NAME="TitanRAG Enterprise Core"

# Security & JWT
SECRET_KEY=titanrag-dev-secret-key-must-be-changed-in-production-min32chars!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# SCIM 2.0
SCIM_BEARER_TOKEN=

# Brute-Force Protection
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION_SECONDS=900

# Rate Limiting & Quotas
RATE_LIMIT_PER_MINUTE_ADMIN=1000
RATE_LIMIT_PER_MINUTE_MEMBER=100
RATE_LIMIT_PER_MINUTE_ANONYMOUS=20
RATE_LIMIT_DISABLED=false
DEFAULT_MONTHLY_CU_QUOTA=10000
DEFAULT_MAX_STORAGE_BYTES=10737418240
DEFAULT_MAX_DOCUMENTS=10000
DEFAULT_MAX_QUERIES_PER_DAY=5000

# Compute Unit (CU) Weights
CU_COST_TEXT_QUERY=1
CU_COST_OCR_PAGE=3
CU_COST_BATCHED_CONTEXT=5
CU_COST_COLPALI_PAGE=10
CU_TOKENS_PER_UNIT=1000

# PostgreSQL (RLS & Transactional Outbox)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_DB=titanrag
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres_dev_password@postgres:5432/titanrag
SYNC_DATABASE_URL=postgresql://postgres:postgres_dev_password@postgres:5432/titanrag
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=3600

# Redis (Broker & Cache)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=20
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Qdrant Vector Engine
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=titan_chunks
QDRANT_COLPALI_COLLECTION_NAME=titan_colpali_visual
QDRANT_DENSE_VECTOR_SIZE=1536
QDRANT_COLPALI_VECTOR_SIZE=128
QDRANT_HNSW_M=16
QDRANT_HNSW_EF_CONSTRUCT=128
QDRANT_QUANTILE=0.99
QDRANT_TENANT_MAX_CONCURRENT=5
QDRANT_SEMAPHORE_TTL_SECONDS=600

# Search & Reranker Timeouts
DENSE_EMBEDDING_TIMEOUT_SECONDS=1.5
QDRANT_SEARCH_TIMEOUT_SECONDS=0.25
RERANKER_TIMEOUT_MS=400
COHERE_RERANK_URL=https://api.cohere.ai/v1/rerank
COHERE_RERANK_MODEL=rerank-v3.5
LITELLM_RERANK_MODEL=bge-reranker-large
RERANKER_FALLBACK_BASE_SCORE=0.90
RERANKER_FALLBACK_STEP=0.08
RERANKER_FALLBACK_MIN_SCORE=0.45

# MinIO Object Storage
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=titanrag-documents
MINIO_USE_SSL=false

# LiteLLM Proxy Gateway
LITELLM_HOST=litellm
LITELLM_PORT=4000
LITELLM_URL=http://litellm:4000
LITELLM_MASTER_KEY=sk-titanrag-litellm-master-key

# NVIDIA NIM Integration
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash-0731
DEFAULT_CHAT_MODEL=deepseek-ai/deepseek-v4-flash-0731
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
COHERE_API_KEY=

# Classifier & Fusion
CLASSIFIER_COMPLEX_QUERY_WORD_THRESHOLD=35
FUSION_STALENESS_PENALTY=0.70

# Stripe Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
STRIPE_CU_METER_EVENT_NAME=compute_units_consumed

# Sandbox Configuration
SANDBOX_SESSION_TTL_HOURS=24
SANDBOX_MAX_QUERIES_PER_HOUR=10
SANDBOX_MAX_UPLOADS_PER_DAY=5
SANDBOX_MAX_STORAGE_BYTES=52428800
SANDBOX_MAX_SESSIONS_PER_IP_PER_DAY=5
SANDBOX_EMAIL_DOMAIN=sandbox.titanrag.io

# White-Label Branding Defaults
BRAND_DEFAULT_COMPANY_NAME=TitanRAG
BRAND_DEFAULT_PRIMARY_COLOR=#6366f1
BRAND_DEFAULT_ACCENT_COLOR=#8b5cf6
BRAND_CACHE_TTL_SECONDS=300
BRAND_ASSET_MAX_BYTES=2097152
BRAND_PRESIGNED_URL_TTL_HOURS=1

# OpenTelemetry & Jaeger Tracing
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=titan-backend
OTEL_TRACES_SAMPLER=always_on

# Frontend & External Access Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
COMPRESSION_MINIMUM_SIZE=1024

# Neo4j Graph Database
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=titan_dev_password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ClamAV Antivirus Daemon
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_ENABLED=true
CLAMAV_TIMEOUT_SECONDS=10

# PgBouncer Connection Pooler
PGBOUNCER_PORT=6432
PGBOUNCER_POOL_MODE=transaction
