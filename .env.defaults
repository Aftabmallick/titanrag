# ==============================================================================
# TitanRAG Container & Development Environment Defaults
# ==============================================================================

# Core System
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
APP_NAME=TitanRAG
API_V1_STR=/api/v1
PROJECT_NAME="TitanRAG Enterprise Core"

# Security & JWT
SECRET_KEY=titanrag-dev-secret-key-must-be-changed-in-production-min32chars!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL (RLS & Transactional Outbox)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_DB=titanrag
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres_dev_password@postgres:5432/titanrag
SYNC_DATABASE_URL=postgresql://postgres:postgres_dev_password@postgres:5432/titanrag

# Redis (Broker & Cache)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Qdrant Vector Engine
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# MinIO Object Storage
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=titanrag-documents
MINIO_USE_SSL=false

# LiteLLM Proxy Gateway
LITELLM_HOST=litellm
LITELLM_PORT=4000
LITELLM_URL=http://litellm:4000
LITELLM_MASTER_KEY=sk-titanrag-litellm-master-key

# NVIDIA NIM Integration
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash-0731
DEFAULT_CHAT_MODEL=deepseek-ai/deepseek-v4-flash-0731

# OpenTelemetry & Jaeger Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=titan-backend
OTEL_TRACES_SAMPLER=always_on

# Frontend & External Access Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Neo4j Graph Database
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=titan_dev_password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
