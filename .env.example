# ==============================================================================
# TitanRAG Local Host Override Template (.env)
# ==============================================================================

# Core System
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG
APP_NAME=TitanRAG
API_V1_STR=/api/v1
PROJECT_NAME="TitanRAG Enterprise Core"

# Security & JWT
SECRET_KEY=titanrag-dev-secret-key-must-be-changed-in-production-min32chars!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL (Host port mapped to 5432)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_DB=titanrag
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres_dev_password@localhost:5432/titanrag
SYNC_DATABASE_URL=postgresql://postgres:postgres_dev_password@localhost:5432/titanrag

# Redis (Host port mapped to 6379)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Qdrant Vector Engine (Host port mapped to 6333)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# MinIO Object Storage (Host port mapped to 9000)
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=titanrag-documents
MINIO_USE_SSL=false

# LiteLLM Proxy Gateway (Host port mapped to 4000)
LITELLM_HOST=localhost
LITELLM_PORT=4000
LITELLM_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-titanrag-litellm-master-key

# OpenTelemetry & Jaeger Tracing (Host port mapped to 4317)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=titan-backend
OTEL_TRACES_SAMPLER=always_on

BACKEND_PORT=8000
FRONTEND_PORT=3000
